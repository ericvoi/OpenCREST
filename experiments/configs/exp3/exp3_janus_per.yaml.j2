{#- Experiment 3 — JANUS PER vs range, per-cell sweep.

Same geometry as Exp 1 (D=120 m, z_s=50 m, z_r=100 m). Five-path
geometric scene: direct + surface + bottom + surface->bottom +
bottom->surface. Range is fixed per cell; modem A may close on modem B
at ``velocity_m_s`` (default -1 m/s) producing within-message Doppler.

Fresh water (saltwater: false) so the SNR-vs-range curve is shaped by
spreading loss and sea-state noise alone (no Thorp absorption), spreading
the sync-threshold transition for a smoother PER-vs-range curve.

Each cell sends N JANUS messages at one (range, velocity, sea_state,
seed) tuple. The driver runs one simulator process per range value
because the geometric scene resets R to ``initial_range_m`` on every TX.

Variables (rendered by exp3_janus_per.py):
  range_m                   (float) cell range in metres
  sea_state                 (int)   Wenz sea state index
  seed                      (int)   per-cell random_seed
  velocity_m_s              (float) closing velocity on modem A
                                    (negative = approaching; default -1.0)
  modem_a_serial            (str)   default OA-2-1
  modem_b_serial            (str)   default OA-2-2
  output_directory          (str)   per-cell output directory
  log_raw_rx                (bool, optional, default false)
-#}
name: exp3_janus_per
description: >
  JANUS 011_01 PER at R={{ "%.0f"|format(range_m|float) }} m,
  v={{ "%.1f"|format((velocity_m_s | default(-1.0))|float) }} m/s, fresh water,
  5-path geometric scene, Wenz sea state {{ sea_state }}, seed {{ seed }}.

environment:
  sound_speed_m_s: 1500.0
  saltwater: false
  spreading_model: spherical
  max_range_m: 1500.0
  max_message_duration_s: 4.0

transducers:
  T-001:
    tvr_db: 172.0
    rvr_db: -200.0
  T-002:
    tvr_db: 170.0
    rvr_db: -200.0

modems:
  - id: modem_a
    usb_serial: "{{ modem_a_serial | default('OA-2-1') }}"
    transducer_id: "T-001"
    velocity_radial_m_s: {{ "%.6f"|format((velocity_m_s | default(-1.0))|float) }}
    acceleration_radial_m_s2: 0.0
  - id: modem_b
    usb_serial: "{{ modem_b_serial | default('OA-2-2') }}"
    transducer_id: "T-002"
    velocity_radial_m_s: 0.0
    acceleration_radial_m_s2: 0.0

channels:
  # A -> B
  - from: modem_a
    to: modem_b
    range_m: {{ "%.3f"|format(range_m|float) }}
    gain_db: -24.0
    mode: geometric
    initial_range_m: {{ "%.3f"|format(range_m|float) }}
    geometry:
      water_depth_m: 120.0
      source_depth_m: 50.0
      receiver_depth_m: 100.0
      gamma_surface: -0.9
      gamma_bottom: 0.7
      spreading_exponent_k: 2.0
      enable_direct: true
      enable_surface: true
      enable_bottom: true
      enable_surface_bottom: true
      enable_bottom_surface: true
      r_min_m: 100.0
      r_max_m: 1200.0
  # B -> A (swap depths so the receiver-depth convention stays consistent)
  - from: modem_b
    to: modem_a
    range_m: {{ "%.3f"|format(range_m|float) }}
    gain_db: -24.0
    mode: geometric
    initial_range_m: {{ "%.3f"|format(range_m|float) }}
    geometry:
      water_depth_m: 120.0
      source_depth_m: 100.0
      receiver_depth_m: 50.0
      gamma_surface: -0.9
      gamma_bottom: 0.7
      spreading_exponent_k: 2.0
      enable_direct: true
      enable_surface: true
      enable_bottom: true
      enable_surface_bottom: true
      enable_bottom_surface: true
      r_min_m: 100.0
      r_max_m: 1200.0

noise:
  wenz_sea_state: {{ sea_state | int }}
  min_margin_above_afe_db: 10.0
  saltwater: false

logging:
  log_raw_tx: false
  log_raw_rx: {{ (log_raw_rx | default(false)) | string | lower }}
  log_processed: false
  output_directory: "{{ output_directory }}"
  file_format: wav
  log_processing_time_histogram: true
  log_message_events: true

random_seed: {{ seed | int }}
