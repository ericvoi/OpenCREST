{#- Experiment 1 — fixed-range geometric channel validation.

Single A->B geometric channel; modem B's RX is the analysis stream.
Stationary scene (v = 0, a = 0). noise.disable=true to isolate multipath
structure. Only modem A's chirp matters for the IR estimate.

Variables:
  seed                (int)   random_seed for this cell
  range_m             (float) line-of-sight range (m)
  modem_a_serial      (str)   USB serial for modem A (default OA-2-1)
  modem_b_serial      (str)   USB serial for modem B (default OA-2-2)
  water_depth_m       (float) default 120
  source_depth_m      (float) default 50
  receiver_depth_m    (float) default 100
  gamma_surface       (float) default -0.9
  gamma_bottom        (float) default  0.7
  spreading_exponent_k(float) default 1.5
  tvr_a_db, rvr_a_db  (float) modem A transducer params (defaults 172, -200)
  tvr_b_db, rvr_b_db  (float) modem B transducer params (defaults 170, -200)
  channel_gain_db     (float) additive trim on the channel chain (default -50)
                              to keep the chirp in the linear DAC range
  output_directory    (str)   per-cell output dir (injected by Sweep runner)
-#}
name: exp1_validation_R{{ "%d"|format(range_m|float|round|int) }}_seed{{ seed|int }}
description: >
  Channel-model validation cell at R={{ "%.1f"|format(range_m|float) }} m,
  seed={{ seed|int }}. Stationary geometric scene (direct + surface +
  bottom paths, noise disabled). A single firmware LFM chirp from modem A
  is captured by modem B's RX.

environment:
  sound_speed_m_s: 1500.0
  saltwater: true
  spreading_model: spherical
  max_range_m: 1100.0
  max_message_duration_s: 1.0

transducers:
  T-001:
    tvr_db: {{ "%.3f"|format(tvr_a_db|default(172.0)|float) }}
    rvr_db: {{ "%.3f"|format(rvr_a_db|default(-200.0)|float) }}
  T-002:
    tvr_db: {{ "%.3f"|format(tvr_b_db|default(170.0)|float) }}
    rvr_db: {{ "%.3f"|format(rvr_b_db|default(-200.0)|float) }}

modems:
  - id: modem_a
    usb_serial: "{{ modem_a_serial | default('OA-2-1') }}"
    transducer_id: "T-001"
    velocity_radial_m_s: 0.0
    acceleration_radial_m_s2: 0.0
  - id: modem_b
    usb_serial: "{{ modem_b_serial | default('OA-2-2') }}"
    transducer_id: "T-002"
    velocity_radial_m_s: 0.0
    acceleration_radial_m_s2: 0.0

channels:
  - from: modem_a
    to: modem_b
    range_m: {{ "%.3f"|format(range_m|float) }}
    gain_db: {{ "%.3f"|format(channel_gain_db|default(-50.0)|float) }}
    mode: geometric
    initial_range_m: {{ "%.3f"|format(range_m|float) }}
    geometry:
      water_depth_m: {{ "%.3f"|format(water_depth_m|default(120.0)|float) }}
      source_depth_m: {{ "%.3f"|format(source_depth_m|default(50.0)|float) }}
      receiver_depth_m: {{ "%.3f"|format(receiver_depth_m|default(100.0)|float) }}
      gamma_surface: {{ "%.3f"|format(gamma_surface|default(-0.9)|float) }}
      gamma_bottom:  {{ "%.3f"|format(gamma_bottom|default(0.7)|float) }}
      spreading_exponent_k: {{ "%.3f"|format(spreading_exponent_k|default(1.5)|float) }}
      enable_direct: true
      enable_surface: true
      enable_bottom: true
      enable_surface_bottom: false
      enable_bottom_surface: false
      r_min_m: {{ "%.3f"|format(((range_m|float) * 0.5)) }}
      r_max_m: {{ "%.3f"|format(((range_m|float) * 2.0)) }}

noise:
  disable: true

logging:
  log_raw_tx: true
  log_raw_rx: true
  log_processed: false
  output_directory: "{{ output_directory }}"
  file_format: wav
  log_processing_time_histogram: true
  log_message_events: true

random_seed: {{ seed|int }}
